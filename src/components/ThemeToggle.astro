---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"

const THEMES = ["Light", "Dark", "System"]
---

<div class="relative ml-1 mr-1">
  <button
    transition:persist
    id="theme-toggle-btn"
    class="appearance-none border-none inline-flex size-11 items-center justify-center rounded-full p-2 transition hover:bg-yellow-400/10 hover:text-yellow-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-500 focus-visible:ring-offset-2 dark:hover:text-yellow-300 dark:focus-visible:ring-offset-gray-950"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="themes-menu"
    aria-label="Choose theme"
  >
    <span class="sr-only">Choose theme</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>
  <div
    transition:persist
    id="themes-menu"
    role="menu"
    aria-label="Theme switcher"
    class="absolute right-0 top-12 hidden min-w-[8rem] rounded-md border border-gray-100 bg-white/90 p-1 text-sm shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md dark:border-gray-500/20 dark:bg-gray-900/90"
  >
    <ul role="none">
      {
        THEMES.map((theme) => (
          <li role="none">
            <button
              type="button"
              role="menuitemradio"
              tabindex="-1"
              data-theme={theme.toLowerCase()}
              aria-checked="false"
              class="themes-menu-option w-full rounded-sm px-3 py-2 text-left hover:bg-neutral-400/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-500 dark:hover:bg-gray-500/50"
            >
              {theme}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #themes-menu.open {
      animation: none;
    }
  }
</style>

<script>
  type ThemePreference = "dark" | "light" | "system"

  const DARK: ThemePreference = "dark"
  const LIGHT: ThemePreference = "light"
  const SYSTEM: ThemePreference = "system"
  const THEME_STORAGE_KEY = "theme"

  let remove: (() => void) | null = null
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)")
  const themesMenu = document.getElementById("themes-menu") as HTMLDivElement
  const toggleBtn = document.getElementById(
    "theme-toggle-btn",
  ) as HTMLButtonElement

  const getThemePreference = (): ThemePreference => {
    const stored = localStorage.getItem(THEME_STORAGE_KEY)

    if (stored === DARK || stored === LIGHT || stored === SYSTEM) {
      return stored
    }

    return SYSTEM
  }

  const updateIcon = (themePreference: ThemePreference): void => {
    document
      .querySelectorAll<HTMLElement>(".theme-toggle-icon")
      .forEach((element) => {
        element.style.scale = element.id === themePreference ? "1" : "0"
      })
  }

  const updateAria = (
    open: boolean,
    themePreference = getThemePreference(),
  ): void => {
    toggleBtn.setAttribute("aria-expanded", String(open))
    const items = themesMenu.querySelectorAll<HTMLElement>(
      '[role="menuitemradio"]',
    )
    items.forEach((item) => {
      item.setAttribute("tabindex", open ? "0" : "-1")
      item.setAttribute(
        "aria-checked",
        String(item.dataset.theme === themePreference),
      )
    })
  }

  const closeMenu = (): void => {
    themesMenu.classList.remove("open")
    updateAria(false)
  }

  const openMenu = (): void => {
    themesMenu.classList.add("open")
    updateAria(true)
    const current = themesMenu.querySelector<HTMLElement>(
      '[role="menuitemradio"][aria-checked="true"]',
    )
    ;(
      current ?? themesMenu.querySelector<HTMLElement>('[role="menuitemradio"]')
    )?.focus()
  }

  const updateTheme = (): void => {
    remove?.()
    matchMedia.addEventListener("change", updateTheme)
    remove = () => matchMedia.removeEventListener("change", updateTheme)

    const themePreference = getThemePreference()
    const isDark =
      themePreference === DARK ||
      (themePreference === SYSTEM && matchMedia.matches)

    updateIcon(themePreference)
    updateAria(themesMenu.classList.contains("open"), themePreference)
    document.documentElement.classList.toggle("dark", isDark)
  }

  updateTheme()

  let abortController: AbortController | null = null

  const attachListeners = () => {
    abortController?.abort()
    abortController = new AbortController()
    const { signal } = abortController

    document.addEventListener("click", () => closeMenu(), { signal })

    toggleBtn?.addEventListener(
      "click",
      (event) => {
        event.stopPropagation()
        if (themesMenu.classList.contains("open")) {
          closeMenu()
        } else {
          openMenu()
        }
      },
      { signal },
    )

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          closeMenu()
          toggleBtn?.focus()
        }
      },
      { signal },
    )

    themesMenu.addEventListener(
      "keydown",
      (event) => {
        const items = Array.from(
          themesMenu.querySelectorAll<HTMLElement>('[role="menuitemradio"]'),
        )
        const current = document.activeElement as HTMLElement
        const index = items.indexOf(current)

        if (event.key === "ArrowDown") {
          event.preventDefault()
          items[(index + 1) % items.length]?.focus()
        } else if (event.key === "ArrowUp") {
          event.preventDefault()
          items[(index - 1 + items.length) % items.length]?.focus()
        }
      },
      { signal },
    )

    themesMenu
      .querySelectorAll<HTMLElement>('[role="menuitemradio"]')
      .forEach((element) => {
        element.addEventListener(
          "click",
          (event) => {
            const theme = (event.currentTarget as HTMLElement).dataset
              .theme as ThemePreference
            localStorage.setItem(THEME_STORAGE_KEY, theme)
            updateTheme()
            closeMenu()
            toggleBtn?.focus()
          },
          { signal },
        )
      })
  }

  attachListeners()

  document.addEventListener("astro:after-swap", () => {
    updateTheme()
    attachListeners()
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  })
</script>
