---
import Layout from "@/layouts/Layout.astro"
import { SITE_CONFIG } from "@/data/site"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeDots from "@/components/icons/CodeDots.astro"
import EngineeringCapabilities from "@/components/EngineeringCapabilities.astro"
import Experience from "@/components/Experience.astro"
import UserHeart from "@/components/icons/UserHeart.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import Achievements from "@/components/Achievements.astro"
import Contact from "@/components/Contact.astro"
import TitleSection from "@/components/TitleSection.astro"
---

<Layout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <main id="main-content" class="px-4">
    <SectionContainer class="py-20 md:py-32">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="projects">
        <TitleSection>
          <CodeDots class="size-7" />
          Selected Work
        </TitleSection>
        <p class="-mt-4 mb-8 max-w-2xl text-gray-600 dark:text-gray-400">
          Filter by discipline and technology to see the projects most relevant
          to your role, team, or product challenge.
        </p>
        <Projects />
      </SectionContainer>

      <SectionContainer id="capabilities">
        <TitleSection>
          <CodeDots class="size-7" />
          Engineering Capabilities
        </TitleSection>
        <p class="-mt-4 mb-8 max-w-2xl text-gray-600 dark:text-gray-400">
          Technologies matter, but the stronger signal is what I can design,
          connect, validate, and operate with them.
        </p>
        <EngineeringCapabilities />
      </SectionContainer>

      <SectionContainer id="experience">
        <TitleSection>
          <Briefcase class="size-8" />
          Engineering Experience
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="achievements">
        <TitleSection>
          <CodeDots class="size-7" />
          Achievements
        </TitleSection>
        <Achievements />
      </SectionContainer>

      <SectionContainer id="about">
        <TitleSection>
          <UserHeart class="size-8" />
          About Me
        </TitleSection>
        <AboutMe />
      </SectionContainer>

      <SectionContainer id="contact">
        <TitleSection>
          <UserHeart class="size-8" />
          Let's Build Something Useful
        </TitleSection>
        <p class="-mt-4 mb-8 max-w-2xl text-gray-600 dark:text-gray-400">
          Planning an engineering project or want to connect? Share the problem,
          constraints, and outcome you need.
        </p>
        <Contact />
      </SectionContainer>
    </div>
  </main>
</Layout>
